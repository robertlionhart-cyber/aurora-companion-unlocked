<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Used ONLY for optional downloads the user starts (models, voices, books) and for update checks
         (Settings > Updates; optional once-a-day check). Chat itself is fully offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 0.8.6: lets the in-app updater hand a downloaded, verified update to Android's installer (the user confirms). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Push-to-talk. Audio is transcribed on the device and never uploaded. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 0.9.3: optional, only if the user turns on "Use approximate location" for weather (Settings > Privacy & online) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Call mode: switch to communication audio (echo cancellation, loudspeaker routing). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- 0.7 reminders: notifications (Android 13+), exact alarms (12 uses SCHEDULE_EXACT_ALARM, 13+ USE_EXACT_ALARM;
         falls back to inexact alarms if refused), and re-arming after a reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 0.8.9: keep the app alive while an AI model is loaded or a call is on (Samsung otherwise freezes and closes it
         in the background). specialUse = "keep an on-device AI model loaded"; microphone only during call mode. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aurora">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 0.7: reminder alarms + Snooze / Done notification actions (internal only). -->
        <receiver android:name=".ReminderReceiver" android:exported="false" />
        <!-- 0.7: re-arm reminders after reboot, app update, clock or time-zone change. -->
        <receiver android:name=".ReminderBootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 0.8.9: keep-alive while a model is loaded / a call is on (internal only). -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a large on-device AI chat model loaded in memory while the user is chatting or in a voice call, so it isn't reloaded (30+ s) every time they switch apps." />
        </service>

        <!-- 0.6: share exported companion packs (cache/share only). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
